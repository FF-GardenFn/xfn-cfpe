# LLM Provider API Keys (copy to .env and fill in — .env is gitignored)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Default Configuration
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=claude-opus-4-5-20251101
MAX_TOKENS=16000
TEMPERATURE=1.0
ENABLE_THINKING=true
THINKING_BUDGET=10000
